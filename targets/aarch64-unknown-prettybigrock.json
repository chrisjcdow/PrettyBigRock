{
  "arch": "aarch64",
  "crt-objects-fallback": "false",
  "data-layout": "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32",
  "disable-redzone": true,
  "executables": true,
  "features": "+v8a,+strict-align,+neon",
  "linker": "rust-lld",
  "linker-flavor": "gnu-lld",
  "llvm-target": "aarch64-unknown-none-elf",
  "max-atomic-width": 128,
  "metadata": {
    "description": "PrettyBigRock programs on ARM64",
    "host_tools": false,
    "std": false,
    "tier": 3
  },
  "os": "prettybigrock",
  "panic-strategy": "abort",
  "position-independent-executables": true,
  "pre-link-args": {
    "gnu-lld": ["--no-dynamic-linker", "-z", "text", "-z", "separate-loadable-segments", "-z", "noexecstack", "--fix-cortex-a53-843419"]
  },
  "relocation-model": "pic",
  "stack-probes": { "kind": "inline" },
  "static-position-independent-executables": true,
  "target-pointer-width": 64,
  "vendor": "unknown"
}
